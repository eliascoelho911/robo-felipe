# Porta do servidor HTTP REST do Core (Hono).
CORE_PORT=3000

# Origem permitida pelo CORS (a Plataforma Android). Use a URL do app ou
# "*" para desenvolvimento local.
CORE_CORS_ORIGIN=*

# Caminho do arquivo SQLite onde vive o estado canônico do pet. O arquivo
# é gitignored — nunca commitar o banco de dados.
CORE_DB_PATH=./felipe.db

# ID do pet Tamagotchi (um por família/Sobrinho).
CORE_PET_ID=felipe-tamagotchi
