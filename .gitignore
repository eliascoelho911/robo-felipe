# ---------- Arduino / ESP32 (samples de referência) ----------
# Build outputs (Arduino CLI / IDE)
/build-*/
*.bin
*.elf
*.hex
*.map
*.partitions.bin
*.ota
# Arduino IDE / CLI caches
.arduinoIDE/
*.tmp
# PlatformIO
.pio/
.piolibdeps/
platformio.ini

# ---------- Chaves de assinatura OTA (ADR-007) ----------
# Chave privada RSA NUNCA entra no repo — fica em CI secret / máquina do dev.
priv_key.pem
*.private.pem
private_key*.pem
*.sign
# Imagem assinada é artefato de release, não de source.
fw.img

# ---------- C / C++ ----------
*.o
*.obj
*.a
*.so
*.exe

# ---------- Python (amostras de áudio/stream) ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
venv/
.venv/
env/
.env
.python-version

# ---------- Artefatos de teste / runtime ----------
# Áudio e logs gerados pelas amostras (stream_mic_serial, etc.)
/audio.raw
/audio.wav
/print.log
*.log

# ---------- Android (app relay) ----------
# Paths locais e caches do Gradle (o android/.gitignore já cobre; repetimos
# por segurança caso o submodule seja tratado como tree única).
android/local.properties
android/.gradle/
android/app/build/
android/build/
android/.idea/
android/captures/
android/.cxx/
android/.externalNativeBuild/

# ---------- IDEs e editores ----------
# VS Code: mantemos .vscode/ (arduino.json, c_cpp_properties.json) versionado,
# mas ignoramos arquivos sensíveis de máquina / cache.
.vscode/*.bak
.vscode/.ropeproject/
# JetBrains
.idea/
*.iml
# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# ---------- SO ----------
.DS_Store
Thumbs.db
desktop.ini
# Metadados ADS do Windows (baixados de outra máquina / navegador)
*:Zone.Identifier
*:Zone.Identifier:*

# ---------- Conteúdo de terceiros / não versionado ----------
# Materiais brutos de tutoriais do kit de origem (PDFs, drivers, instaladores,
# zips de bibliotecas, .sb3): binários de terceiros com questões de
# licença/distribuição. Manter fora do repositório.
/tutorial_raw/
